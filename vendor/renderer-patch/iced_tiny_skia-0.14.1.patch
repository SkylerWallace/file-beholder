+// Keep the reference rasterizer for curved edge bands. Only the known opaque,
+// integer-aligned interior is filled directly; clipped/translucent cases fall back.
+fn fill_solid_interior(
+    pixels: &mut tiny_skia::PixmapMut<'_>,
+    path: &tiny_skia::Path,
+    transform: tiny_skia::Transform,
+    bounds: Rectangle,
+    radius: f32,
+    color: Color,
+    mask: Option<&tiny_skia::Mask>,
+    clip: Rectangle,
+) -> bool {
+    if crate::profile::reference_raster() {
+        return false;
+    }
+    let left = bounds.x;
+    let right = bounds.x + bounds.width;
+    if ![clip.x, clip.y, clip.width, clip.height]
+        .into_iter()
+        .all(f32::is_finite)
+    {
+        return false;
+    }
+    let top = (bounds.y + radius).ceil().max(0.0).max(clip.y.ceil());
+    let bottom = (bounds.y + bounds.height - radius)
+        .floor()
+        .min(pixels.height() as f32)
+        .min((clip.y + clip.height).floor());
+    if ![left, right, top, bottom].into_iter().all(f32::is_finite)
+        || left.fract() != 0.0
+        || right.fract() != 0.0
+        || top < 0.0
+        || bottom > pixels.height() as f32
+        || bottom <= top
+    {
+        return false;
+    }
+    let Some(physical) = path.clone().transform(transform) else {
+        return false;
+    };
+    let width = pixels.width();
+    let height = pixels.height();
+    let paint = tiny_skia::Paint {
+        shader: tiny_skia::Shader::SolidColor(into_color(color)),
+        anti_alias: true,
+        ..Default::default()
+    };
+    let pixel: u32 = bytemuck::cast(into_color(color).to_color_u8().premultiply());
+    let top = top as usize;
+    let bottom = bottom as usize;
+    let stride = width as usize * 4;
+    let data = pixels.data_mut();
+    let start = left.max(0.0) as usize;
+    let end = right.min(width as f32).max(0.0) as usize;
+    if start >= end || start > width as usize {
+        return false;
+    }
+    for (index, row) in data[top * stride..bottom * stride]
+        .chunks_exact_mut(stride)
+        .enumerate()
+    {
+        // Engine clip masks are non-antialiased axis-aligned rectangles (0/255).
+        let (begin, finish) = if let Some(mask) = mask {
+            let line = &mask.data()
+                [(top + index) * width as usize + start..(top + index) * width as usize + end];
+            let Some(first) = line.iter().position(|v| *v == 255) else {
+                continue;
+            };
+            let last = line.iter().rposition(|v| *v == 255).unwrap();
+            (start + first, start + last + 1)
+        } else {
+            (start, end)
+        };
+        let target = &mut row[begin * 4..finish * 4];
+        if let Ok(words) = bytemuck::try_cast_slice_mut::<u8, u32>(target) {
+            words.fill(pixel);
+        } else {
+            for bytes in target.chunks_exact_mut(4) {
+                bytes.copy_from_slice(&pixel.to_ne_bytes());
+            }
+        }
+    }
+    if top > 0 {
+        let clipped = mask.map(|m| {
+            tiny_skia::Mask::from_vec(
+                m.data()[..top * width as usize].to_vec(),
+                tiny_skia::IntSize::from_wh(width, top as u32).unwrap(),
+            )
+            .unwrap()
+        });
+        let mut band =
+            tiny_skia::PixmapMut::from_bytes(&mut data[..top * stride], width, top as u32).unwrap();
+        band.fill_path(
+            &physical,
+            &paint,
+            tiny_skia::FillRule::EvenOdd,
+            tiny_skia::Transform::identity(),
+            clipped.as_ref(),
+        );
+    }
+    if bottom < height as usize {
+        let clipped = mask.map(|m| {
+            tiny_skia::Mask::from_vec(
+                m.data()[bottom * width as usize..].to_vec(),
+                tiny_skia::IntSize::from_wh(width, height - bottom as u32).unwrap(),
+            )
+            .unwrap()
+        });
+        let mut band = tiny_skia::PixmapMut::from_bytes(
+            &mut data[bottom * stride..],
+            width,
+            height - bottom as u32,
+        )
+        .unwrap();
+        band.fill_path(
+            &physical,
+            &paint,
+            tiny_skia::FillRule::EvenOdd,
+            tiny_skia::Transform::from_translate(0.0, -(bottom as f32)),
+            clipped.as_ref(),
+        );
+    }
+    true
+}
