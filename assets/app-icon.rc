1 ICON "assets/app-icon.ico"

1 VERSIONINFO
 FILEVERSION @VERSION_NUMBERS@
 PRODUCTVERSION @VERSION_NUMBERS@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x00040004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "File Beholder\0"
            VALUE "FileVersion", "@PACKAGE_VERSION@\0"
            VALUE "InternalName", "file-beholder\0"
            VALUE "OriginalFilename", "file-beholder.exe\0"
            VALUE "ProductName", "File Beholder\0"
            VALUE "ProductVersion", "@PACKAGE_VERSION@\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 File Beholder contributors\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
